# ============================================================
# Word Embedding Chatbot API — Environment Variables Example
# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# IMPORTANT: Never commit your real `.env` file. It is
# git-ignored. Keep secrets out of version control.
# ============================================================


# ─── NODEJS SERVER ENV ───────────────────────────────────────

# Runtime environment. In "production" several vars become required.
NODE_ENV=development

# Port the Node.js (Hono) API listens on.
PORT=9999

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# SQLite (dev: file:dev.db) or Turso libSQL URL (prod: libsql://...).
# Must be a valid URL.
DATABASE_URL=file:dev.db

# Required only in production when using Turso cloud.
DATABASE_AUTH_TOKEN=

# JWT access-token secrets. Use strong random strings (> 32 characters).
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_SECRET_PUBLIC=

# JWT token lifetime in days.
ACCESS_TOKEN_EXPIRES_IN=1
ACCESS_TOKEN_EXPIRES_IN_PUBLIC=1

# Upstash Redis (rate limiting). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pinecone vector DB API key (used by the "pinecone" embedding mode).
PINECONE_API_KEY=

# Password shared between Node API and Python ML server.
API_PASSWORD=

# Base URL of the Python ML (FastAPI) server.
PYTHON_SERVER_URL=http://localhost:8888

# OpenAI API key (GPT answer generation on the Node side).
OPEN_AI_API_KEY=


# ─── PYTHON SERVER ENV ───────────────────────────────────────

# CORS allowed origins for the FastAPI server.
ALLOWED_ORIGINS=*

# Password shared with the Node API (must match API_PASSWORD above).
API_PASSWORD=

# OpenAI API key used by the Python ML server.
OPENAI_API_KEY=

# Port the Python ML server listens on.
PORT_PY=8888
